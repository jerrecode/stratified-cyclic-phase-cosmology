{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jerrecode/stratified-cyclic-phase-cosmology/data/manifest.schema.json",
  "title": "SCPC public cosmology data release manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "last_verified",
    "quantity_registry",
    "release_files"
  ],
  "properties": {
    "manifest_version": {"type": "string"},
    "last_verified": {"type": "string", "format": "date"},
    "project": {"type": "object"},
    "unit_conventions": {"type": "object"},
    "quantity_registry": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/quantity"}
    },
    "release_files": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "quantity": {
      "type": "object",
      "required": ["symbol", "unit", "dimension", "description"],
      "properties": {
        "symbol": {"type": "string"},
        "unit": {"type": "string"},
        "dimension": {"type": "string"},
        "description": {"type": "string"},
        "relation": {"type": "string"}
      },
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "required": ["name", "unit", "dimension", "description"],
      "properties": {
        "name": {"type": "string"},
        "symbol": {"type": "string"},
        "unit": {"type": "string"},
        "dimension": {"type": "string"},
        "shape": {"type": "string"},
        "relation": {"type": "string"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "required": ["id", "required", "purpose", "formats", "variables"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "required": {"type": "boolean"},
        "purpose": {"type": "string"},
        "selection": {"type": "string"},
        "formats": {"type": "array", "items": {"type": "string"}},
        "expected_scale": {"type": "string"},
        "variables": {"type": "array", "items": {"$ref": "#/$defs/variable"}}
      },
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "required": ["method", "authentication", "instructions"],
      "properties": {
        "method": {"type": "string"},
        "base_url": {"type": "string"},
        "authentication": {"type": "string"},
        "instructions": {"type": "array", "items": {"type": "string"}},
        "commands": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["id", "title", "provider", "release", "access_level", "scientific_domains", "roles", "landing_page", "documentation", "license", "access", "products"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "title": {"type": "string"},
        "provider": {"type": "string"},
        "release": {"type": "string"},
        "release_date": {"type": "string"},
        "access_level": {"const": "public"},
        "scientific_domains": {"type": "array", "items": {"type": "string"}},
        "roles": {"type": "array", "items": {"type": "string"}},
        "landing_page": {"type": "string"},
        "documentation": {"type": "string"},
        "citation": {"type": "string"},
        "license": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}},
        "access": {"$ref": "#/$defs/access"},
        "products": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/product"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
